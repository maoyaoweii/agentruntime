<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        style="@style/T.Section"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="下达任务" />

    <EditText
        android:id="@+id/et_goal"
        style="@style/Input"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:hint="用一句话描述要做什么，例如：打开笔记新建一条记录"
        android:inputType="textMultiLine"
        android:maxLines="4"
        android:importantForAutofill="no" />

    <CheckBox
        android:id="@+id/cb_auto_confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:buttonTint="@color/brand"
        android:checked="false"
        android:text="自动确认高风险动作（发送/支付/删除；仅测试环境）"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_run"
            style="@style/Btn.Primary"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="48dp"
            android:text="开始执行" />

        <Button
            android:id="@+id/btn_console"
            style="@style/Btn.Ghost"
            android:layout_width="112dp"
            android:layout_height="48dp"
            android:layout_marginStart="10dp"
            android:text="控制台" />
    </LinearLayout>

    <TextView
        style="@style/T.Caption"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="快捷指令" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/chip_observe"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="观察环境"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip_screenshot"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="截图留证"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/chip_smoke"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_chip"
            android:gravity="center"
            android:text="工具冒烟"
            android:textColor="@color/text_primary"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
