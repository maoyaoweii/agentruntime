{
  "skill_id": "sys.ui_launch_tap",
  "version": "1.0",
  "target_package": null,
  "args": ["app_package", "text"],
  "risk": "MEDIUM",
  "confirmation": "never",
  "max_retries": 1,
  "recovery": "非 AgentTestApp 的第三方应用：启动后按可见文字定位并坐标点击（节点兜底，不依赖端侧视觉模型权重）。text 支持多个候选，用 | 分隔，命中任一即可，用于应对中文目标与英文界面的差异",
  "postconditions": [],
  "steps": [
    {"action": "launch_app", "params": {"package": "${app_package}"}, "timeout_ms": 40000},
    {"action": "wait_for", "params": {"package": "${app_package}"}, "timeout_ms": 60000},
    {"action": "wait_for", "params": {"package": "${app_package}", "ui_contains": "${text}"}, "timeout_ms": 40000},
    {"action": "wait_ms", "params": {"ms": 800}, "timeout_ms": 5000},
    {"action": "visual_tap", "params": {"target": "${text}", "allow_vision": false}, "timeout_ms": 30000},
    {"action": "wait_ms", "params": {"ms": 1200}, "timeout_ms": 5000}
  ]
}
