  "postconditions": [],
  "steps": [
    {"action": "open_settings_page", "params": {"page": "app_details", "package": "${package}"}, "timeout_ms": 15000},
    {"action": "wait_ms", "params": {"ms": 1200}, "timeout_ms": 4000}
  ]
}
